# ─── Site ────────────────────────────────────────────────────────────
# Public production URL (canonical URLs, sitemap, OG images, RSS)
NEXT_PUBLIC_SITE_URL=https://jaiminpanchal.com

# Show unverified (draft) records with a "Needs verification" badge.
# Local review only. NEVER set to true in production.
CONTENT_PREVIEW_UNVERIFIED=false

# ─── Sanity CMS ──────────────────────────────────────────────────────
# Leave empty to run on local seed content (src/content/seed.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Server-only. Viewer token: draft preview / Presentation tool.
SANITY_API_READ_TOKEN=
# Server-only. Editor token, used ONLY to store contact submissions under the private "leads." path.
SANITY_API_WRITE_TOKEN=
# Secret shared with the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# ─── Contact delivery (Resend) ───────────────────────────────────────
RESEND_API_KEY=
# Where contact notifications are sent (your private inbox)
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Portfolio <hello@jaiminpanchal.com>"
CONTACT_FROM_EMAIL=

# ─── Search engines ──────────────────────────────────────────────────
# Google Search Console "HTML tag" verification code (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 code
NEXT_PUBLIC_BING_SITE_VERIFICATION=
