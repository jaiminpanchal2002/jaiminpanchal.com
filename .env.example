# ---------------------------------------------------------------------------
# Database (PostgreSQL) — required
# Local dev + production both use Postgres. Free option: Neon (neon.tech).
# Copy the "pooled" connection string. Example:
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Auth — required
# 32+ char random secret used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Seed admin credentials (used once by `npm run db:seed`). Change the password!
ADMIN_EMAIL="admin@jaiminpanchal.com"
ADMIN_PASSWORD="use-a-strong-password"

# Public site URL (used for canonical, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://jaiminpanchal.com"

# ---------------------------------------------------------------------------
# File uploads (production) — Vercel Blob
# Set automatically when you connect a Blob store to the Vercel project.
# When unset, uploads fall back to local disk (dev only).
# BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Apify job discovery (server-only) — optional
# APIFY_API_TOKEN=""
# APIFY_JOBS_ACTOR="TrtlecxAsNRbKl1na"   # valig/indeed-jobs-scraper

# ---------------------------------------------------------------------------
# AI provider for ATS enrichment (server-only) — optional
# Without a key the ATS analyzer runs in deterministic mode.
# AI_PROVIDER="anthropic"                # or "openai"
# AI_PROVIDER_API_KEY=""
# AI_MODEL="claude-3-5-haiku-latest"
